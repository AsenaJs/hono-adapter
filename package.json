{
  "name": "@asenajs/hono-adapter",
  "module": "index.ts",
  "description": "Hono server and websocket adapter for Asenajs ",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "version": "3.2.0",
  "author": "LibirSoft",
  "repository": {
    "type": "git",
    "url": "https://github.com/AsenaJs/hono-adapter.git"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.12"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "build": "bun run clean && tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "benchmark": "bun run benchmark/run-benchmark.ts",
    "benchmark:native": "bun run benchmark/native-hono.ts",
    "benchmark:adapter": "bun run benchmark/hono-adapter.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check",
    "check:fix": "bun run lint:fix && bun run format",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@asenajs/asena": "^0.10.1",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "hono": "^4.13.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@asenajs/asena": "^0.10.1",
    "hono": ">=4.12.9",
    "typescript": "^5.8.2",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0"
  }
}
